lucide lucide-truck w-5 h-5 text-primary\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\"></path><path d=\"M15 18H9\"></path><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14\"></path><circle cx=\"17\" cy=\"18\" r=\"2\"></circle><circle cx=\"7\" cy=\"18\" r=\"2\"></circle></svg></div></div><div class=\"p-5\"><h3 class=\"font-display font-semibold text-lg mb-2\">Lojistik &amp; Nakliye</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Deniz, hava ve kara yolu ile uluslararası nakliye organizasyonu ve takibi.</p></div></div><div class=\"group bg-card rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-video bg-muted\"><img alt=\"Gümrükleme\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/img-customs.png\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent\"></div><div class=\"absolute bottom-3 left-3 p-2 bg-white/90 dark:bg-gray-900/90 rounded-lg backdrop-blur-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check w-5 h-5 text-primary\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"m9 15 2 2 4-4\"></path></svg></div></div><div class=\"p-5\"><h3 class=\"font-display font-semibold text-lg mb-2\">Gümrükleme</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Gümrük mevzuatına uygun belge hazırlığı, tarife belirleme ve gümrük işlemlerinin takibi.</p></div></div><div class=\"group bg-card rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-video bg-muted\"><img alt=\"E-Ticaret Çözümleri\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/img-ecommerce.jpg\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent\"></div><div class=\"absolute bottom-3 left-3 p-2 bg-white/90 dark:bg-gray-900/90 rounded-lg backdrop-blur-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shopping-cart w-5 h-5 text-primary\"><circle cx=\"8\" cy=\"21\" r=\"1\"></circle><circle cx=\"19\" cy=\"21\" r=\"1\"></circle><path d=\"M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12\"></path></svg></div></div><div class=\"p-5\"><h3 class=\"font-display font-semibold text-lg mb-2\">E-Ticaret Çözümleri</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Amazon FBA, Etsy ve diğer platformlar için private label ürün tedariği, barkodlama ve depolama hizmetleri.</p></div></div><div class=\"group bg-card rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-video bg-muted\"><img alt=\"Satın Alma Danışmanlığı\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/service-consulting.jpg\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent\"></div><div class=\"absolute bottom-3 left-3 p-2 bg-white/90 dark:bg-gray-900/90 rounded-lg backdrop-blur-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-handshake w-5 h-5 text-primary\"><path d=\"m11 17 2 2a1 1 0 1 0 3-3\"></path><path d=\"m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4\"></path><path d=\"m21 3 1 11h-2\"></path><path d=\"M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3\"></path><path d=\"M3 4h8\"></path></svg></div></div><div class=\"p-5\"><h3 class=\"font-display font-semibold text-lg mb-2\">Satın Alma Danışmanlığı</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">Üreticilerle sözleşme yönetimi, fiyat müzakeresi ve satın alma süreçlerinin profesyonel yönetimi.</p></div></div><div class=\"group bg-card rounded-xl overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 hover:-translate-y-1\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-video bg-muted\"><img alt=\"ABD Gümrük Uyumluluğu\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/img-customs.png\"/><div class=\"absolute inset-0 bg-gradient-to-t from-black/40 to-transparent\"></div><div class=\"absolute bottom-3 left-3 p-2 bg-white/90 dark:bg-gray-900/90 rounded-lg backdrop-blur-sm\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check w-5 h-5 text-primary\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"></path><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"></path><path d=\"m9 15 2 2 4-4\"></path></svg></div></div><div class=\"p-5\"><h3 class=\"font-display font-semibold text-lg mb-2\">ABD Gümrük Uyumluluğu</h3><p class=\"text-muted-foreground text-sm leading-relaxed\">HTS kodu belirleme, Section 301 tarife analizi, ISF beyanı ve ABD gümrük mevzuatına tam uyum süreçleriyle ithalatınızı risksiz yönetiyoruz.</p></div></div></div></div></section><section id=\"process\" class=\"py-20 sm:py-28\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-16\" style=\"opacity:0;transform:translateY(20px)\"><h2 class=\"font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4\">Nasıl Çalışırız?</h2><p class=\"text-muted-foreground text-lg max-w-2xl mx-auto\">Adım adım ithalat süreci</p></div><div class=\"relative\"><div class=\"absolute left-6 sm:left-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-300 via-teal-300 to-pink-300 hidden sm:block\"></div><div class=\"space-y-8 sm:space-y-12\"><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row\" style=\"opacity:0;transform:translateX(-40px)\"><div class=\"flex-1 sm:pr-12 sm:text-right\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-end\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">1</span><h3 class=\"font-display font-semibold text-lg\">İhtiyaç Analizi</h3></div><p class=\"text-muted-foreground text-sm\">Ürün gereksinimlerinizi detaylı olarak analiz ediyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-clipboard-list w-5 h-5\"><rect width=\"8\" height=\"4\" x=\"8\" y=\"2\" rx=\"1\" ry=\"1\"></rect><path d=\"M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2\"></path><path d=\"M12 11h4\"></path><path d=\"M12 16h4\"></path><path d=\"M8 11h.01\"></path><path d=\"M8 16h.01\"></path></svg></div><div class=\"hidden sm:block flex-1\"></div></div><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row-reverse\" style=\"opacity:0;transform:translateX(40px)\"><div class=\"flex-1 sm:pl-12 sm:text-left\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-start\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">2</span><h3 class=\"font-display font-semibold text-lg\">Tedarikçi Araştırması</h3></div><p class=\"text-muted-foreground text-sm\">Çin&#x27;deki güvenilir tedarikçileri araştırıp karşılaştırıyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search w-5 h-5\"><circle cx=\"11\" cy=\"11\" r=\"8\"></circle><path d=\"m21 21-4.3-4.3\"></path></svg></div><div class=\"hidden sm:block flex-1\"></div></div><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row\" style=\"opacity:0;transform:translateX(-40px)\"><div class=\"flex-1 sm:pr-12 sm:text-right\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-end\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">3</span><h3 class=\"font-display font-semibold text-lg\">Numune &amp; Kalite Kontrol</h3></div><p class=\"text-muted-foreground text-sm\">Numune siparişi verip kalite kontrollerini gerçekleştiriyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-package w-5 h-5\"><path d=\"m7.5 4.27 9 5.15\"></path><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg></div><div class=\"hidden sm:block flex-1\"></div></div><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row-reverse\" style=\"opacity:0;transform:translateX(40px)\"><div class=\"flex-1 sm:pl-12 sm:text-left\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-start\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">4</span><h3 class=\"font-display font-semibold text-lg\">Sipariş &amp; Üretim</h3></div><p class=\"text-muted-foreground text-sm\">Siparişi onaylayıp üretim sürecini yakından takip ediyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-factory w-5 h-5\"><path d=\"M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z\"></path><path d=\"M17 18h1\"></path><path d=\"M12 18h1\"></path><path d=\"M7 18h1\"></path></svg></div><div class=\"hidden sm:block flex-1\"></div></div><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row\" style=\"opacity:0;transform:translateX(-40px)\"><div class=\"flex-1 sm:pr-12 sm:text-right\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-end\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">5</span><h3 class=\"font-display font-semibold text-lg\">Lojistik &amp; Gümrük</h3></div><p class=\"text-muted-foreground text-sm\">Nakliye ve gümrük işlemlerini eksiksiz yönetiyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-truck w-5 h-5\"><path d=\"M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2\"></path><path d=\"M15 18H9\"></path><path d=\"M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14\"></path><circle cx=\"17\" cy=\"18\" r=\"2\"></circle><circle cx=\"7\" cy=\"18\" r=\"2\"></circle></svg></div><div class=\"hidden sm:block flex-1\"></div></div><div class=\"relative flex items-start gap-4 sm:gap-0 sm:flex-row-reverse\" style=\"opacity:0;transform:translateX(40px)\"><div class=\"flex-1 sm:pl-12 sm:text-left\"><div class=\"bg-card rounded-xl p-6 shadow-md hover:shadow-lg transition-shadow\"><div class=\"flex items-center gap-3 mb-2 sm:justify-start\"><span class=\"sm:hidden flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white text-sm font-bold\">6</span><h3 class=\"font-display font-semibold text-lg\">Teslimat</h3></div><p class=\"text-muted-foreground text-sm\">Ürünlerinizi güvenle kapınıza teslim ediyoruz.</p></div></div><div class=\"hidden sm:flex items-center justify-center w-12 h-12 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 text-white shadow-lg z-10 flex-shrink-0\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check-big w-5 h-5\"><path d=\"M21.801 10A10 10 0 1 1 17 3.335\"></path><path d=\"m9 11 3 3L22 4\"></path></svg></div><div class=\"hidden sm:block flex-1\"></div></div></div></div></div></section><section id=\"about\" class=\"py-20 sm:py-28 pastel-gradient-2\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"grid lg:grid-cols-2 gap-12 items-center\"><div class=\"relative aspect-[4/3] rounded-xl overflow-hidden shadow-xl bg-muted\" style=\"opacity:0;transform:translateX(-40px)\"><img alt=\"Çin&#x27;den Al Sat danışmanlık ekibi iş ortaklarıyla buluşmada\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/team-meeting.jpg\"/><div class=\"absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/70 to-transparent p-4\"><p class=\"text-white text-sm font-medium\">Shenzhen&#x27;da iş ortaklarımızla</p></div></div><div style=\"opacity:0;transform:translateX(40px)\"><h2 class=\"font-display text-3xl sm:text-4xl font-bold tracking-tight mb-2\">Hakkımızda</h2><p class=\"text-primary font-semibold mb-6\">ABD&#x27;deki Türk Girişimcilere Özel</p><p class=\"text-muted-foreground leading-relaxed mb-4\">Çin&#x27;den Al Sat İthalat Danışmanlığı olarak, ABD&#x27;de yaşayan ve iş yapan Türk girişimcilere özel Çin ithalat danışmanlık hizmeti sunuyoruz. Gümrük, tarifeler ve lojistik süreçlerinde uzman ekibimizle yanınızdayız.</p><p class=\"text-muted-foreground leading-relaxed mb-8\">ABD gümrük mevzuatı, HTS kodları, Section 301 tarifeleri ve e-ticaret lojistik süreçlerinde deneyimliyiz. Amazon FBA, Etsy ve kendi marka ürünleriniz için uçtan uca destek sunuyoruz.</p><div class=\"grid grid-cols-2 gap-6\"><div class=\"bg-card rounded-xl p-4 shadow-md text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-users w-6 h-6 text-primary mx-auto mb-2\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"></path><circle cx=\"9\" cy=\"7\" r=\"4\"></circle><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"></path><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"></path></svg><span class=\"font-display text-3xl sm:text-4xl font-bold bg-gradient-to-r from-blue-500 to-teal-400 bg-clip-text text-transparent\">0<!-- -->+</span><p class=\"text-sm text-muted-foreground mt-1\">Mutlu Müşteri</p></div><div class=\"bg-card rounded-xl p-4 shadow-md text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-package w-6 h-6 text-primary mx-auto mb-2\"><path d=\"m7.5 4.27 9 5.15\"></path><path d=\"M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z\"></path><path d=\"m3.3 7 8.7 5 8.7-5\"></path><path d=\"M12 22V12\"></path></svg><span class=\"font-display text-3xl sm:text-4xl font-bold bg-gradient-to-r from-blue-500 to-teal-400 bg-clip-text text-transparent\">0<!-- -->+</span><p class=\"text-sm text-muted-foreground mt-1\">Tedarik Edilen Ürün</p></div><div class=\"bg-card rounded-xl p-4 shadow-md text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-earth w-6 h-6 text-primary mx-auto mb-2\"><path d=\"M21.54 15H17a2 2 0 0 0-2 2v4.54\"></path><path d=\"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17\"></path><path d=\"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg><span class=\"font-display text-3xl sm:text-4xl font-bold bg-gradient-to-r from-blue-500 to-teal-400 bg-clip-text text-transparent\">0<!-- -->+</span><p class=\"text-sm text-muted-foreground mt-1\">Ülkeye Teslimat</p></div><div class=\"bg-card rounded-xl p-4 shadow-md text-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-6 h-6 text-primary mx-auto mb-2\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span class=\"font-display text-3xl sm:text-4xl font-bold bg-gradient-to-r from-blue-500 to-teal-400 bg-clip-text text-transparent\">0<!-- -->+</span><p class=\"text-sm text-muted-foreground mt-1\">Yıllık Deneyim</p></div></div></div></div></div></section><section class=\"py-16 sm:py-20 bg-card\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-12\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera w-4 h-4\"><path d=\"M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg>Yerinde Operasyonlar</div><h2 class=\"font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4\">Çin&#x27;de Fiziksel Varlığımız</h2><p class=\"text-muted-foreground text-lg max-w-2xl mx-auto\">Uzaktan yönetilen ithalatın aksine, tedarikçilerle yüz yüze çalışıyor, fabrikaları ve pazarları yerinde inceliyoruz.</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-4 gap-4\"><div class=\"group\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-[4/3] rounded-xl overflow-hidden shadow-md bg-muted\"><img alt=\"Müşteri ile birlikte Çin pazar araştırması\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/market-research.jpg\"/></div><p class=\"text-sm text-muted-foreground mt-3 text-center px-1\">Müşterimizle birlikte yerinde pazar araştırması</p></div><div class=\"group\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-[4/3] rounded-xl overflow-hidden shadow-md bg-muted\"><img alt=\"Müşteri ve iş ortağı buluşturma toplantısı\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/client-matching.jpg\"/></div><p class=\"text-sm text-muted-foreground mt-3 text-center px-1\">Müşteri ve iş ortağı buluşturma toplantıları</p></div><div class=\"group\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-[4/3] rounded-xl overflow-hidden shadow-md bg-muted\"><img alt=\"Çin iş ortaklarıyla yemekli toplantı\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/china-dinner.jpg\"/></div><p class=\"text-sm text-muted-foreground mt-3 text-center px-1\">Çin&#x27;de iş ortaklarımızla yemekli toplantılar</p></div><div class=\"group\" style=\"opacity:0;transform:translateY(30px)\"><div class=\"relative aspect-[4/3] rounded-xl overflow-hidden shadow-md bg-muted\"><img alt=\"Samimi ilişkiler başarılı ticaret\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover group-hover:scale-105 transition-transform duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/images/business-relationship.jpg\"/></div><p class=\"text-sm text-muted-foreground mt-3 text-center px-1\">Samimi ilişkiler, başarılı ticaret</p></div></div></div></section><section class=\"py-16 sm:py-20\"><div class=\"max-w-[1000px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-10\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-factory w-4 h-4\"><path d=\"M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z\"></path><path d=\"M17 18h1\"></path><path d=\"M12 18h1\"></path><path d=\"M7 18h1\"></path></svg>Fabrika Ziyaretleri</div><h2 class=\"font-display text-3xl sm:text-4xl font-bold tracking-tight mb-4\">Tedarikçi Fabrikalarını Yerinde Denetliyoruz</h2><p class=\"text-muted-foreground text-lg max-w-2xl mx-auto\">Kalite kontrolü sadece numune ile sınırlı kalmıyor — üretim tesislerini bizzat ziyaret ediyoruz.</p></div><div class=\"relative rounded-2xl overflow-hidden shadow-xl bg-black aspect-video\" style=\"opacity:0;transform:scale(0.97)\"><video controls=\"\" preload=\"metadata\" poster=\"/videos/factory-visit-poster.jpg\" class=\"w-full h-full object-cover\"><source src=\"/videos/factory-visit.mp4\" type=\"video/mp4\"/></video></div><p class=\"text-center text-sm text-muted-foreground mt-4\">Çin&#x27;deki tedarikçi fabrika ziyaretlerimizden bir kesit</p></div></section><section class=\"py-20 sm:py-28 bg-gradient-to-br from-gray-50 via-blue-50/30 to-teal-50/30\"><div class=\"max-w-[1200px] mx-auto px-4 sm:px-6\"><div class=\"text-center mb-16\" style=\"opacity:0;transform:translateY(30px)\"><h2 class=\"text-3xl sm:text-4xl font-display font-bold text-gray-900 mb-4\">Müşterilerimiz Ne Diyor?</h2><p class=\"text-lg text-gray-600 max-w-2xl mx-auto\">Güvenle çalıştığımız müşterilerimizin deneyimleri</p></div><div class=\"grid sm:grid-cols-2 lg:grid-cols-3 gap-6\"><div class=\"relative bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-lg transition-shadow\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote absolute top-4 right-4 w-8 h-8 text-blue-100\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg><div class=\"flex gap-0.5 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg></div><p class=\"text-gray-700 text-sm leading-relaxed mb-6 relative z-10\">“<!-- -->Çin&#x27;den mobilya hammaddesi ithalatında çok profesyonel bir hizmet aldık. Kalite kontrol süreçleri ve lojistik yönetimi mükemmeldi. Kesinlikle tavsiye ediyorum.<!-- -->”</p><div class=\"flex items-center gap-3\"><div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 flex items-center justify-center text-white font-bold text-sm flex-shrink-0\">A</div><div><p class=\"font-semibold text-gray-900 text-sm\">Ahmet Yılmaz</p><p class=\"text-gray-500 text-xs\">Genel Müdür<!-- --> • <!-- -->Yılmaz Mobilya</p></div></div></div><div class=\"relative bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-lg transition-shadow\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote absolute top-4 right-4 w-8 h-8 text-blue-100\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg><div class=\"flex gap-0.5 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg></div><p class=\"text-gray-700 text-sm leading-relaxed mb-6 relative z-10\">“<!-- -->DİR belgesi ile ithalat sürecinde büyük kolaylık sağladılar. Vergisiz ithalat avantajıyla maliyetlerimizi önemli ölçüde düşürdük.<!-- -->”</p><div class=\"flex items-center gap-3\"><div class=\"w-10 h-10 rounded-full bg-gradient-to-br from-blue-500 to-teal-400 flex items-center justify-center text-white font-bold text-sm flex-shrink-0\">F</div><div><p class=\"font-semibold text-gray-900 text-sm\">Fatma Demir</p><p class=\"text-gray-500 text-xs\">Satın Alma Müdürü<!-- --> • <!-- -->DekoPlus</p></div></div></div><div class=\"relative bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-lg transition-shadow\" style=\"opacity:0;transform:translateY(30px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote absolute top-4 right-4 w-8 h-8 text-blue-100\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg><div class=\"flex gap-0.5 mb-4\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-star w-4 h-4 fill-yellow-400 text-yellow-400\"><polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon></svg><svg xmln