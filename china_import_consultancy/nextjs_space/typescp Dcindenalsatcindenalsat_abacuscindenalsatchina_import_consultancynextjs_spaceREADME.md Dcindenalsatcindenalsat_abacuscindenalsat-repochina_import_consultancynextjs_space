// ============================================
// Admin Panel Types & Interfaces
// ============================================

// Admin User Roles
export type AdminRole = 'super_admin' | 'admin' | 'editor' | 'viewer'

// Admin Permissions
export type AdminPermission =
  | 'manage_pages'       // Sayfa yönetimi
  | 'manage_theme'       // Tema özelleştirme
  | 'manage_navigation'  // Menü yönetimi
  | 'manage_users'       // Kullanıcı yönetimi
  | 'manage_content'     // İçerik yönetimi (blog, ürün, hizmet)
  | 'manage_media'       // Medya kütüphanesi
  | 'manage_seo'         // SEO ayarları
  | 'view_analytics'     // Analitik görüntüleme
  | 'manage_settings'    // Genel ayarlar
  | 'manage_backups'     // Yedekleme
  | 'view_activity_logs' // Aktivite loglarını görüntüleme

// Admin User Interface
export interface AdminUser {
  id: string
  email: string
  name?: string
  role: AdminRole
  avatar?: string
  permissions: AdminPermission[]
  lastLoginAt?: Date
  createdAt: Date
  updatedAt: Date
}

// Page Type
export interface Page {
  id: string
  slug: string
  titleTr: string
  titleEn: string
  contentTr: string
  contentEn: string
  metaTitleTr?: string
  metaTitleEn?: string
  metaDescTr?: string
  metaDescEn?: string
  ogImage?: string
  published: boolean
  showInNav: boolean
  navOrder: number
  layout: 'default' | 'full-width' | 'sidebar'
  customCss?: string
  customJs?: string
  authorId: string
  author?: {
    id: string
    name: string
    email: string
  }
  createdAt: Date
  updatedAt: Date
}

// Navigation Item Type
export interface NavigationItem {
  id: string
  labelTr: string
  labelEn: string
  href: string
  parentId?: string
  icon?: string
  target: '_self' | '_blank'
  sortOrder: number
  published: boolean
  children?: NavigationItem[]
  createdAt: Date
  updatedAt: Date
}

// Theme Configuration Type
export interface ThemeConfig {
  id: string
  primaryHue: number      // 0-360
  primarySaturation: number   // 0-100
  primaryLightness: number    // 0-100

  accentHue: number
  accentSaturation: number
  accentLightness: number

  secondaryHue: number
  secondarySaturation: number
  secondaryLightness: number

  bodyFont: string
  headingFont: string
  monoFont: string
  baseFontSize: number  // px

  borderRadius: number  // rem
  spacingUnit: number   // px

  darkBackgroundHue: number
  darkBackgroundSat: number
  darkBackgroundLight: number

  enableDarkMode: boolean
  customCss?: string

  updatedAt: Date
}

// Site Setting Type
export interface SiteSetting {
  id: string
  key: string

  // Site Info
  siteNameTr?: string
  siteNameEn?: string
  siteTaglineTr?: string
  siteTaglineEn?: string
  siteLogo?: string
  siteFavicon?: string

  // Contact Info
  phone?: string
  email?: string
  whatsapp?: string
  addressTr?: string
  addressEn?: string

  // Social Media
  facebook?: string
  instagram?: string
  twitter?: string
  youtube?: string
  linkedin?: string

  // SEO
  defaultMetaTitleTr?: string
  defaultMetaTitleEn?: string
  defaultMetaDescTr?: string
  defaultMetaDescEn?: string
  defaultOgImage?: string
  googleAnalyticsId?: string
  googleSiteVerification?: string

  // Features
  enableBlog: boolean
  enableContactForm: boolean
  enableTestimonials: boolean

  updatedAt: Date
}

// Media File Type
export interface MediaFile {
  id: string
  filename: string
  originalName: string
  mimeType: string
  size: number  // bytes
  url: string
  altText?: string
  folder?: string
  uploadedBy?: string
  createdAt: Date
  updatedAt: Date
}

// Admin Activity Log Type
export interface AdminActivityLog {
  id: string
  userId: string
  action: 'create' | 'update' | 'delete' | 'publish' | 'login' | 'logout'
  resource: string  // page, theme, user, navigation, etc.
  resourceId?: string
  details?: string  // JSON string
  ipAddress?: string
  userAgent?: string
  createdAt: Date
}

// API Response Types
export interface ApiResponse<T = any> {
  success?: boolean
  data?: T
  message?: string
  error?: string
  errors?: Array<{ field: string; message: string }>
}

export interface PaginatedResponse<T = any> extends ApiResponse<T> {
  total?: number
  page?: number
  pageSize?: number
  totalPages?: number
}

